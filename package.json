{
	"name": "@ramtinj95/pi-stuff-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"install:ci": "bun install --frozen-lockfile",
		"check": "node scripts/workspaces.mjs check",
		"typecheck": "node scripts/workspaces.mjs typecheck",
		"test": "node scripts/workspaces.mjs test",
		"changeset": "changeset",
		"version-packages": "changeset version && bun install --lockfile-only --ignore-scripts",
		"release": "changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@earendil-works/pi-agent-core": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-tui": "1.5.0",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "^26.6.5",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"typebox": "1.4.3",
		"typescript": "^7.0.2"
	}
}
